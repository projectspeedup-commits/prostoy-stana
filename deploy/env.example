# Скопируйте в .env рядом с compose.yaml и заполните. Файл .env в Git не кладём.

# Ключи устройств боевого сервиса: название:ключ, несколько — через запятую.
# Формат: планшет1:длинная-случайная-строка,телефон:другая-строка
STAN_DEVICE_KEYS=

# Ключи устройств тестового сервиса (профиль test), в том же формате.
STAN_TEST_DEVICE_KEYS=

# Рассылка сводки смены на почту (боевой сервис). Пустые SMTP_USER, SMTP_PASS или MAIL_TO — рассылка выключена.
# Яндекс: нужен пароль приложения (не пароль от аккаунта), SMTP по SSL, порт 465.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Получатели через запятую
MAIL_TO=
# Адрес отправителя; пусто — как SMTP_USER
MAIL_FROM=
# Ссылка на пульт в письме; пусто — https://stan.tmpz-engineering.ru/
PUBLIC_URL=
