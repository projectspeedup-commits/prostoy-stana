# Скопируйте в .env рядом с compose.yaml и заполните. Файл .env в Git не кладём.

# Ключи устройств боевого сервиса: название:ключ, несколько — через запятую.
# Формат: планшет1:длинная-случайная-строка,телефон:другая-строка
STAN_DEVICE_KEYS=

# Ключи устройств тестового сервиса (профиль test), в том же формате.
STAN_TEST_DEVICE_KEYS=

# Отправка почты (боевой сервис). Пустые SMTP_USER или SMTP_PASS — отправка не настроена, рассылка выключена.
# Яндекс: нужен пароль приложения (не пароль от аккаунта), SMTP по SSL, порт 465.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Запасные получатели через запятую: получают сводку смены в 08:05 и 20:05, пока владелец не задал список в «Администратор» > «Рассылка на почту»
MAIL_TO=
# Адрес отправителя; пусто — как SMTP_USER
MAIL_FROM=
# Ссылка на пульт в письме; пусто — https://stan.tmpz-engineering.ru/
PUBLIC_URL=

# ИИ-консультант в «Администратор» (DeepSeek, формат OpenAI). Пустой ключ — функция выключена.
DEEPSEEK_API_KEY=
# Модель; пусто — deepseek-flash
STAN_AI_MODEL=
# Адрес API; пусто — https://api.deepseek.com
STAN_AI_BASE_URL=
# Дневной лимит расходов на ИИ в долларах; пусто — 1
STAN_AI_DAILY_USD=
